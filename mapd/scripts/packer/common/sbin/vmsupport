OUTPUT="./vmsupport-bundle.tgz"
LOG_DIR="/var/log"
HARBOR_INSTALLER_ROOTDIR="/data/harbor/installer/harbor"
MAP_INSTALLER_ROOTDIR="/data/map/installer/map-offline-installer"

vmbootstrap --debug | tee /var/run/ovfenv.json
cmd="tar -czf ${OUTPUT} /var/run/ovfenv.json ${LOG_DIR} ${MAP_INSTALLER_ROOTDIR}/config.yml ${MAP_INSTALLER_ROOTDIR}/common ${MAP_INSTALLER_ROOTDIR}/docker-compose.yml"
if [ -f "${HARBOR_INSTALLER_ROOTDIR}/harbor.yml" ]; then
  cmd="$cmd ${HARBOR_INSTALLER_ROOTDIR}/harbor.yml"
fi
if [ -d "${HARBOR_INSTALLER_ROOTDIR}/common" ]; then
  cmd="$cmd ${HARBOR_INSTALLER_ROOTDIR}/common"
fi
if [ -f "${MAP_INSTALLER_ROOTDIR}/docker-compose.yml" ]; then
  cmd="$cmd ${MAP_INSTALLER_ROOTDIR}/docker-compose.yml"
fi
eval "$cmd"